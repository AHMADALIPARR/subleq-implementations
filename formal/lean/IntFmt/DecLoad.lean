SPDX-License-Identifier: AGPL-3.0-only

Program identity for the assembled 2323-cell `intfmt.dec` image.

Deterministic loading procedure
===============================

1. Assemble `microcode/tinyprintf/intfmt.s` with `microcode/tinyprintf/asm16`
   to produce `microcode/tinyprintf/intfmt.dec` (whitespace-separated signed
   16-bit decimals, 2323 cells).
2. Copy that artifact to `formal/lean/IntFmt/intfmt.dec` (byte-identical;
   SHA-256 is recorded in `intfmtDecSha256` and
   `formal/results/intfmt.dec.sha256`).
3. This module embeds the copy with `include_str` and defines a pure total
   Lean parser `parseDecText` (split on whitespace, parse optional-minus
   decimals, wrap into `UInt16`).
4. `intfmtImage` in `Image.lean` is generated by `formal/lean/gen-image.sh`
   (bash/awk, no Python) from the official `.dec`. Re-running the generator
   is byte-identical (`formal/lean/check-image.sh`).
5. Kernel theorems below record the image size, the constant cells, and
   that the parser is correct on the first `.dec` line (including the
   unique `-32768` literal). The full kernel equality
   `parseDecText intfmtDecText = intfmtImage` is proved in `DecBind.lean`
   by parsing each newline-terminated line and concatenating the chunks.
   `intfmtDecText` is the concatenation of those line literals, which
   `check-image.sh` (a `lake build` extraDep target) binds to the official
   assembled artifact and its SHA-256. The `include_str` copy is
   `intfmtDecTextFile`.
6. `loadImage` (see `ImageRun.lean`) maps address `a` to cell `a` of
   `intfmtImage` (or `0` past the end). That is the memory image used by
   `runImage`.

The SHA-256 below is `sha256sum` of the official assembled artifact.
-/

import IntFmt.Image

namespace IntFmt

-- Indexing a 2323-element array literal needs a deeper kernel reducer.
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

/-- Reproducible SHA-256 of `microcode/tinyprintf/intfmt.dec`
(and of the embedded `IntFmt/intfmt.dec` copy). Hex, lowercase. -/
def intfmtDecSha256 : String :=
  "bc8679df169f382114b779b54e97bdf21bccc94bf6341ca55374f357610f94c6"

theorem intfmtDecSha256_len : intfmtDecSha256.length = 64 := rfl

/-- Embedded file copy of the assembled artifact (for the build-time
byte check). The kernel theorem uses `intfmtDecText`, the concatenation
of the generated line literals in `DecChunks`. -/
def intfmtDecTextFile : String := include_str "intfmt.dec"

/-- Wrap a signed integer into a 16-bit cell (two's complement).
Lean's `Int.emod` yields a representative in `0 .. m-1`. -/
def wordOfInt (n : Int) : UInt16 :=
  UInt16.ofNat (n % 65536).toNat

theorem wordOfInt_zero : wordOfInt 0 = 0 := rfl
theorem wordOfInt_one : wordOfInt 1 = 1 := rfl
theorem wordOfInt_48 : wordOfInt 48 = 48 := rfl
theorem wordOfInt_45 : wordOfInt 45 = 45 := rfl
theorem wordOfInt_min : wordOfInt (-32768) = 32768 := rfl

/-- Whitespace predicate used by the `.dec` parser. -/
def isDecWS (c : Char) : Bool :=
  c = ' ' || c = '\n' || c = '\t' || c = '\r'

/-- Parse a decimal digit list into a natural number. -/
def parseNatChars (cs : List Char) : Nat :=
  cs.foldl (fun n c => n * 10 + (c.toNat - '0'.toNat)) 0

/-- Parse an optional-minus decimal token. Malformed tokens yield `0`. -/
def parseSignedChars (cs : List Char) : Int :=
  match cs with
  | [] => 0
  | '-' :: rest => -(parseNatChars rest : Int)
  | _ => (parseNatChars cs : Int)

theorem parseSignedChars_0 : parseSignedChars ['0'] = 0 := rfl
theorem parseSignedChars_48 : parseSignedChars ['4', '8'] = 48 := rfl
theorem parseSignedChars_min :
    parseSignedChars ['-', '3', '2', '7', '6', '8'] = -32768 := rfl
theorem parse_min_cell :
    wordOfInt (parseSignedChars ['-', '3', '2', '7', '6', '8']) = 32768 := rfl

/-- Fuel-bounded tokenizer. `tokensAux cs.length cs` returns every
whitespace-separated token of `cs`. -/
def tokensAux : Nat → List Char → List (List Char)
  | 0, _ => []
  | _, [] => []
  | n + 1, c :: rest =>
    if isDecWS c then
      tokensAux n rest
    else
      let tok := (c :: rest).takeWhile (fun x => !isDecWS x)
      let after := (c :: rest).dropWhile (fun x => !isDecWS x)
      tok :: tokensAux n after

/-- Split a character list into whitespace-separated tokens. -/
def tokensChars (cs : List Char) : List (List Char) :=
  tokensAux cs.length cs

/-- Deterministic parser of a `.dec` character list. -/
def parseDecChars (cs : List Char) : Array UInt16 :=
  ((tokensChars cs).map (fun t => wordOfInt (parseSignedChars t))).toArray

/-- Deterministic parser of a `.dec` text string. -/
def parseDecText (s : String) : Array UInt16 :=
  parseDecChars s.toList

/-- Interpreter / file-embed parse (see also `intfmtImage_eq_parse`). -/
def intfmtImageParsed : Array UInt16 :=
  parseDecText intfmtDecTextFile

/-- The assembled program has exactly 2323 cells. -/
theorem intfmtImage_size : intfmtImage.size = 2323 := rfl

/-- First-line `.dec` text (cells 0..15), including the trailing newline. -/
def intfmtDecLine0 : String :=
  "0 0 48 1 10 100 1000 10000 48 45 32 -32768 0 8 0 0\n"

/-- Parser correctness on the first 16-cell line, including `-32768`. -/
theorem parseDec_line0 :
    parseDecText intfmtDecLine0 =
      #[0, 0, 48, 1, 10, 100, 1000, 10000, 48, 45, 32, 32768, 0, 8, 0, 0] :=
  rfl

/-- Cells 0..15 of the Lean image match the parser of the first `.dec` line. -/
theorem intfmtImage_prefix16 :
    intfmtImage.extract 0 16 =
      #[0, 0, 48, 1, 10, 100, 1000, 10000, 48, 45, 32, 32768, 0, 8, 0, 0] :=
  rfl

theorem intfmtImage_prefix16_eq_parse :
    intfmtImage.extract 0 16 = parseDecText intfmtDecLine0 := by
  rw [intfmtImage_prefix16, parseDec_line0]

/-- Selected concrete cells of the assembled image (kernel `rfl`). -/
theorem image_cell_Z : intfmtImage[0]! = 0 := rfl
theorem image_cell_startTarget : intfmtImage[2]! = 48 := rfl
theorem image_cell_ONE : intfmtImage[3]! = 1 := rfl
theorem image_cell_TEN : intfmtImage[4]! = 10 := rfl
theorem image_cell_C100 : intfmtImage[5]! = 100 := rfl
theorem image_cell_C1000 : intfmtImage[6]! = 1000 := rfl
theorem image_cell_C10000 : intfmtImage[7]! = 10000 := rfl
theorem image_cell_K48 : intfmtImage[8]! = 48 := rfl
theorem image_cell_K45 : intfmtImage[9]! = 45 := rfl
theorem image_cell_K32 : intfmtImage[10]! = 32 := rfl
theorem image_cell_K32768 : intfmtImage[11]! = 32768 := rfl
theorem image_cell_CAP_default : intfmtImage[13]! = 8 := rfl
theorem image_cell_last : intfmtImage[2322]! = 5 := rfl
theorem image_cell_haltTarget : intfmtImage[2318]! = 32768 := rfl

end IntFmt
